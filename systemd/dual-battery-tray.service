[Unit]
Description=Dual Battery Tray (HeadsetControl + Keychron K2 HE)
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/dual-battery-tray --config %h/.config/dual-battery-tray/config.toml
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=dual_battery_tray=info

[Install]
WantedBy=graphical-session.target
